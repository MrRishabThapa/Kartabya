DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kartabya
FRONTEND_URL=http://localhost:3000
# Optional comma-separated origins in addition to FRONTEND_URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional regex for a controlled set of temporary frontend origins, e.g.
# ^https://([a-z0-9-]+)\\.ngrok-free\\.app$
# CORS_ORIGIN_REGEX=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
AUTH_SESSION_COOKIE_NAME=kartabya_session
AUTH_SESSION_TTL_SECONDS=604800
OPEN_AI_KEY=
OPENAI_MODEL=gpt-4o-mini
